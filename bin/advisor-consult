#!/usr/bin/env node
import fs from "node:fs";
import path from "node:path";
import {
  runAdvisorConsult,
  checkAdvisorQuota,
  getDataDir,
  isSensitiveFilePath,
  resetEmissionState,
  dumpAdvisorTranscript,
  loadWatchdogRuntimeSettings,
  saveWatchdogRuntimeSettings,
  discoverWatchdogMarkdownFiles,
  discoverWatchdogRoster,
  TIER_NAMES,
  FOCUS_MODES,
  EFFORT_LEVELS,
} from "../mcp/advisor-core.mjs";

function printHelp() {
  console.log(`Usage: advisor-consult [options] [prompt | -]

Cross-model Goldfish & OMP Watchdog advisor CLI powered by Antigravity subscription models
(1-shot zero-tool mode with [Blocker | Concern | Nit] calibration, AdvisorEmissionGuard NFKC deduplication,
WATCHDOG.md / WATCHDOG.yml discovery, live quota tracking, and no rate limits).

Options:
  --status, --models, --log   Show live subscription quota %, Watchdog/EmissionGuard state, and recent call log
  --focus <mode>              Review mode: ${FOCUS_MODES.join(" | ")} (default: general)
  --tier <preset>             Model preset: ${TIER_NAMES.join(" | ")} | <model-id>
  --model <model-id>          Alias for --tier
  --effort <level>            Reasoning effort: ${EFFORT_LEVELS.join(" | ")}
  --advisor <name>            Named roster advisor from WATCHDOG.yml (e.g. arch, sec)
  --workspace <dir>           Workspace root directory (default: current directory)
  --file <path>               Target file or slice ('path:start-end', 'path#Lstart-Lend', 'path:line') (repeatable)
  --diff                      Include git status and git diff HEAD (or git show HEAD) from workspace
  --transcript <path>         Optional session transcript.jsonl path for incremental OMP delta review
  --dump                      Dump formatted peer-shadow transcript (__advisor[.<slug>].jsonl)
  --dump-raw                  Dump raw JSONL peer-shadow transcript
  --reset                     Clear AdvisorEmissionGuard deduplication state & transcript cursor for workspace
  --watchdog <mode>           Configure OMP Watchdog mode: on | off | turn | agent-end | status
  --timeout <sec>             Optional timeout override in seconds (min: 5, max: 600; defaults to tier preset)
  --force                     Bypass duplicate-upgrading when re-auditing
  -h, --help                  Show this help message
`);
}

function requireArgValue(argv, index, flagName) {
  if (
    index + 1 >= argv.length ||
    argv[index + 1].startsWith("--") ||
    !argv[index + 1].trim()
  ) {
    throw new Error(`Missing value for ${flagName}`);
  }
  return argv[index + 1];
}

async function main() {
  const argv = process.argv.slice(2);
  let focus = "general";
  let tier = "auto";
  let effort = undefined;
  let advisor = null;
  let workspace = process.cwd();
  const files = [];
  let includeGitDiff = false;
  let transcriptPath = null;
  let timeoutMs = undefined;
  let force = false;
  let readStdin = false;
  let showHelp = false;
  let showStatus = false;
  let dumpMode = null;
  let doReset = false;
  let watchdogCmd = null;
  const promptParts = [];

  for (let i = 0; i < argv.length; i++) {
    let arg = argv[i];
    let inlineVal = undefined;
    if (arg.startsWith("--") && arg.includes("=")) {
      const eqIdx = arg.indexOf("=");
      inlineVal = arg.slice(eqIdx + 1);
      arg = arg.slice(0, eqIdx);
    }
    const nextVal = (flag) => {
      if (inlineVal !== undefined) {
        if (!inlineVal.trim()) {
          throw new Error(`Missing value for ${flag}`);
        }
        return inlineVal;
      }
      return requireArgValue(argv, i++, flag);
    };
    const noVal = (flag) => {
      if (inlineVal !== undefined) {
        throw new Error(`Option ${flag} does not take a value`);
      }
    };

    if (arg === "-h" || arg === "--help") {
      noVal(arg);
      showHelp = true;
    } else if (arg === "--models" || arg === "--status" || arg === "--log") {
      noVal(arg);
      showStatus = true;
    } else if (arg === "--focus") {
      focus = nextVal("--focus");
    } else if (arg === "--tier" || arg === "--model") {
      tier = nextVal(arg);
    } else if (arg === "--effort") {
      effort = nextVal("--effort");
    } else if (arg === "--advisor") {
      advisor = nextVal("--advisor");
    } else if (arg === "--workspace") {
      workspace = nextVal("--workspace");
    } else if (arg === "--file") {
      files.push(nextVal("--file"));
    } else if (arg === "--diff") {
      noVal("--diff");
      includeGitDiff = true;
    } else if (arg === "--transcript") {
      transcriptPath = nextVal("--transcript");
    } else if (arg === "--dump") {
      noVal("--dump");
      dumpMode = "formatted";
    } else if (arg === "--dump-raw") {
      noVal("--dump-raw");
      dumpMode = "raw";
    } else if (arg === "--reset") {
      noVal("--reset");
      doReset = true;
    } else if (arg === "--watchdog") {
      watchdogCmd = nextVal("--watchdog").toLowerCase();
    } else if (arg === "--timeout") {
      const sec = Number(nextVal("--timeout"));
      if (!Number.isFinite(sec) || sec <= 0) {
        throw new Error("Invalid --timeout value (must be positive seconds)");
      }
      timeoutMs = Math.min(Math.max(Math.round(sec * 1000), 5000), 600000);
    } else if (arg === "--force") {
      noVal("--force");
      force = true;
    } else if (arg === "-") {
      readStdin = true;
    } else if (arg === "--") {
      promptParts.push(...argv.slice(i + 1));
      break;
    } else if (arg.startsWith("-")) {
      throw new Error(`Unknown option: ${arg}`);
    } else {
      promptParts.push(argv[i]);
    }
  }

  if (showHelp) {
    printHelp();
    return;
  }

  const dataDir = getDataDir();
  const resolvedWorkspace = path.resolve(workspace || process.cwd());

  if (doReset) {
    resetEmissionState(dataDir, resolvedWorkspace);
    console.log(
      `Reset AdvisorEmissionGuard deduplication history and transcript cursor for workspace: ${resolvedWorkspace}`
    );
    return;
  }

  if (watchdogCmd) {
    if (watchdogCmd === "status") {
      const settings = loadWatchdogRuntimeSettings(dataDir);
      const mdFiles = discoverWatchdogMarkdownFiles(
        resolvedWorkspace,
        isSensitiveFilePath
      );
      const roster = discoverWatchdogRoster(
        resolvedWorkspace,
        isSensitiveFilePath
      );
      console.log(
        JSON.stringify(
          {
            workspace: resolvedWorkspace,
            settings,
            watchdogMarkdownFiles: mdFiles.map((m) => m.source),
            watchdogRoster:
              roster && roster.sources.length > 0
                ? {
                    sources: roster.sources,
                    settings: roster.settings,
                    advisors: roster.advisors,
                  }
                : null,
          },
          null,
          2
        )
      );
      return;
    }
    if (watchdogCmd === "off") {
      const updated = saveWatchdogRuntimeSettings(dataDir, {
        enabled: false,
        reviewMode: "off",
      });
      console.log(`OMP Watchdog disabled (${JSON.stringify(updated)})`);
      return;
    }
    if (watchdogCmd === "on" || watchdogCmd === "agent-end") {
      const updated = saveWatchdogRuntimeSettings(dataDir, {
        enabled: true,
        reviewMode: "agent-end",
      });
      console.log(
        `OMP Watchdog enabled in 'agent-end' mode (${JSON.stringify(updated)})`
      );
      return;
    }
    if (watchdogCmd === "turn") {
      const updated = saveWatchdogRuntimeSettings(dataDir, {
        enabled: true,
        reviewMode: "turn",
      });
      console.log(
        `OMP Watchdog enabled in 'turn' mode (${JSON.stringify(updated)})`
      );
      return;
    }
    throw new Error(
      `Invalid --watchdog mode '${watchdogCmd}' (expected: on | off | turn | agent-end | status)`
    );
  }

  if (dumpMode) {
    console.log(
      dumpAdvisorTranscript(dataDir, advisor, dumpMode === "raw", 20)
    );
    return;
  }

  if (showStatus) {
    const res = await checkAdvisorQuota(resolvedWorkspace);
    console.log(res.text);
    return;
  }

  let prompt = promptParts.join(" ").trim();
  if (!prompt && readStdin) {
    prompt = fs.readFileSync(0, "utf8").trim();
  }

  if (!prompt) {
    printHelp();
    process.exitCode = 1;
    return;
  }

  const controller = new AbortController();
  const onSignal = () => controller.abort();
  process.on("SIGINT", onSignal);
  process.on("SIGTERM", onSignal);

  try {
    const result = await runAdvisorConsult({
      prompt,
      focus,
      tier,
      effort,
      advisor,
      workspace: resolvedWorkspace,
      files,
      includeGitDiff,
      transcriptPath,
      timeoutMs,
      force,
      signal: controller.signal,
    });

    if (result.isError) {
      console.error(result.text);
      process.exitCode = 1;
      return;
    }
    console.log(result.text);
  } finally {
    process.off("SIGINT", onSignal);
    process.off("SIGTERM", onSignal);
  }
}

main().catch((err) => {
  console.error(`Error: ${err.message || err}`);
  process.exitCode = 1;
});
