#!/usr/bin/env node
import fs from "node:fs";
import {
  runAdvisorConsult,
  checkAdvisorQuota,
  TIER_NAMES,
  FOCUS_MODES,
  EFFORT_LEVELS,
} from "../mcp/advisor-core.mjs";

function printHelp() {
  console.log(`Usage: advisor-consult [options] [prompt | -]

Cross-model Goldfish advisor CLI powered by Antigravity subscription models
(1-shot zero-tool mode with [Blocker | Major | Nit] calibration, live quota tracking, and no rate limits).

Options:
  --status, --models, --log   Show live subscription quota %, recent advisor call log, and tiers
  --focus <mode>              Review mode: ${FOCUS_MODES.join(" | ")} (default: general)
  --tier <preset>             Model preset: ${TIER_NAMES.join(" | ")} | <model-id>
  --model <model-id>          Alias for --tier
  --effort <level>            Reasoning effort: ${EFFORT_LEVELS.join(" | ")}
  --workspace <dir>           Workspace root directory (default: current directory)
  --file <path>               Target file or slice ('path:start-end', 'path#Lstart-Lend', 'path:line') (repeatable)
  --diff                      Include git status and git diff HEAD (or git show HEAD) from workspace
  --force                     Optional compatibility flag (no rate limits or cooldowns are enforced)
  -h, --help                  Show this help message
`);
}

function requireArgValue(argv, index, flagName) {
  if (index + 1 >= argv.length) {
    throw new Error(`Missing value for ${flagName}`);
  }
  return argv[index + 1];
}

async function main() {
  const argv = process.argv.slice(2);
  let focus = "general";
  let tier = "auto";
  let effort = undefined;
  let workspace = process.cwd();
  const files = [];
  let includeGitDiff = false;
  let force = false;
  let readStdin = false;
  let showHelp = false;
  let showStatus = false;
  const promptParts = [];

  for (let i = 0; i < argv.length; i++) {
    const arg = argv[i];
    if (arg === "-h" || arg === "--help") {
      showHelp = true;
    } else if (arg === "--models" || arg === "--status" || arg === "--log") {
      showStatus = true;
    } else if (arg === "--focus") {
      focus = requireArgValue(argv, i++, "--focus");
    } else if (arg.startsWith("--focus=")) {
      focus = arg.slice("--focus=".length);
    } else if (arg === "--tier" || arg === "--model") {
      tier = requireArgValue(argv, i++, arg);
    } else if (arg.startsWith("--tier=")) {
      tier = arg.slice("--tier=".length);
    } else if (arg.startsWith("--model=")) {
      tier = arg.slice("--model=".length);
    } else if (arg === "--effort") {
      effort = requireArgValue(argv, i++, "--effort");
    } else if (arg.startsWith("--effort=")) {
      effort = arg.slice("--effort=".length);
    } else if (arg === "--workspace") {
      workspace = requireArgValue(argv, i++, "--workspace");
    } else if (arg.startsWith("--workspace=")) {
      workspace = arg.slice("--workspace=".length);
    } else if (arg === "--file") {
      files.push(requireArgValue(argv, i++, "--file"));
    } else if (arg.startsWith("--file=")) {
      files.push(arg.slice("--file=".length));
    } else if (arg === "--diff") {
      includeGitDiff = true;
    } else if (arg === "--force") {
      force = true;
    } else if (arg === "-") {
      readStdin = true;
    } else if (arg === "--") {
      promptParts.push(...argv.slice(i + 1));
      break;
    } else if (arg.startsWith("-")) {
      throw new Error(`Unknown option: ${arg}`);
    } else {
      promptParts.push(arg);
    }
  }

  if (showHelp) {
    printHelp();
    return;
  }

  if (showStatus) {
    const res = await checkAdvisorQuota();
    console.log(res.text);
    return;
  }

  let prompt = promptParts.join(" ").trim();
  if (!prompt && readStdin) {
    prompt = fs.readFileSync(0, "utf8").trim();
  }

  if (!prompt) {
    printHelp();
    process.exitCode = 1;
    return;
  }

  const controller = new AbortController();
  const onSignal = () => controller.abort();
  process.on("SIGINT", onSignal);
  process.on("SIGTERM", onSignal);

  try {
    const result = await runAdvisorConsult({
      prompt,
      focus,
      tier,
      effort,
      workspace,
      files,
      includeGitDiff,
      force,
      signal: controller.signal,
    });

    if (result.isError) {
      console.error(result.text);
      process.exitCode = 1;
      return;
    }
    console.log(result.text);
  } finally {
    process.off("SIGINT", onSignal);
    process.off("SIGTERM", onSignal);
  }
}

main().catch((err) => {
  console.error(`Error: ${err.message || err}`);
  process.exitCode = 1;
});
